# generated by okay-deploy from demo-chat's Deployment value — edit the value, not this file
[Unit]
Description=demo-chat / chat
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=demo-chat
Group=demo-chat
WorkingDirectory=/opt/demo-chat/chat
EnvironmentFile=/etc/demo-chat/chat.env
ExecStart=/usr/bin/env java -cp /opt/demo-chat/chat/app.jar okay.demo.ChatDemo
Restart=on-failure
RestartSec=5
TimeoutStartSec=30
TimeoutStopSec=30
# what a service can reach, narrowed to what it needs
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/app/data /var/lib/demo-chat/chat

[Install]
WantedBy=multi-user.target
