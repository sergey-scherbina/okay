# generated by okay-deploy from okay-script's Deployment value — edit the value, not this file
[Unit]
Description=okay-script / web
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=okay-script
Group=okay-script
WorkingDirectory=/opt/okay-script/web
EnvironmentFile=/etc/okay-script/web.env
ExecStart=/usr/bin/env java -cp /opt/okay-script/web/app.jar okay.script.Serve
Restart=on-failure
RestartSec=5
TimeoutStartSec=30
TimeoutStopSec=30
# what a service can reach, narrowed to what it needs
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/app/data /var/lib/okay-script/web

[Install]
WantedBy=multi-user.target
