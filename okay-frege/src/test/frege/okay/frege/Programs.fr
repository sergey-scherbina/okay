--- Frege programs the okay tests run (TestFrege), written in okay.frege.Prog
module okay.frege.Programs where

import okay.frege.Prog

--- the core effects' operations (okay.frege.Ops), one pure native each
pure native askOp    okay.frege.Ops.ask     :: () -> Operation Long
pure native getOp    okay.frege.Ops.get     :: () -> Operation Long
pure native setOp    okay.frege.Ops.set     :: Long -> Operation Long
pure native raiseOp  okay.frege.Ops.raise   :: String -> Operation Long
pure native choose2  okay.frege.Ops.choose2 :: Long -> Long -> Operation Long

--- a running sum, iteratee style: await until Nothing, tell each sum
runningSum :: Long -> Prog ()
runningSum acc = do
  m <- await
  case m of
    Nothing -> return ()
    Just x  -> tell (acc + x) >> runningSum (acc + x)

--- tells a header before its first await, and a count at the end
framed :: Int -> Prog ()
framed n = do
  when (n == 0) (tell "head")
  m <- await
  case m of
    Nothing -> tell ("n=" ++ show n)
    Just x  -> tell (show (x :: Long)) >> framed (n + 1)

--- reads three elements and returns: the stage ends early
firstThree :: Int -> Prog ()
firstThree 3 = return ()
firstThree n = do
  m <- await
  case m of
    Nothing -> return ()
    Just x  -> tell (x :: Long) >> firstThree (n + 1)

--- Reader and State, performed from Frege: env * 1000 + the state after +1
readerState :: Prog Long
readerState = do
  env <- perform (askOp ())
  s   <- perform (getOp ())
  _   <- perform (setOp (s + 1))
  s2  <- perform (getOp ())
  return (env * 1000 + s2)

--- a Throws raised from Frege
raising :: Prog Long
raising = perform (raiseOp "boom from frege")

--- MULTI-SHOT: Choose resumes the continuation once per branch
choosing :: Prog Long
choosing = do
  a <- perform (choose2 1 2)
  b <- perform (choose2 10 20)
  return (a + b)

--- existing Frege IO, lifted as one step
greetIO :: String -> IO String
greetIO who = return ("hello, " ++ who)

usesIO :: Prog String
usesIO = do
  g <- liftIO (greetIO "okay")
  tell g
  return (g ++ "!")

--- a Frege failure of its own, inside the tree
failing :: Prog Long
failing = perform (askOp ()) >>= \e -> if e > 0 then error "frege says no" else return e

--- a long loop, for the stack and the price
countTo :: Long -> Long -> Prog ()
countTo i n = if i >= n then return () else tell i >> countTo (i + 1) n

--- existing Frege IO lifted in a program okay RUNS (no tell): its answer
liftedAnswer :: Prog String
liftedAnswer = fmap (++ "!") (liftIO (greetIO "okay"))

pure native sleepOp  okay.frege.Ops.sleep   :: Long -> Operation Long

--- STAGE 2: a stage that also performs — keeps the elements above a
--- threshold it ASKS from okay's Reader (asked once per element, to
--- show the operations interleave with the stage's own)
aboveThreshold :: Prog ()
aboveThreshold = do
  m <- await
  case m of
    Nothing -> return ()
    Just x  -> do
      t <- perform (askOp ())
      when ((x :: Long) > t) (tell x)
      aboveThreshold

--- Async from Frege: two sleeps, answering the milliseconds slept
sleepTwice :: Prog Long
sleepTwice = do
  a <- perform (sleepOp 20)
  b <- perform (sleepOp 20)
  return (a + b)

--- lists: an INFINITE Frege list, for okay to read partially
squares :: [Long]
squares = map (\x -> x * x) (iterate (+1) 1)

--- lists: a Frege function over a list okay hands in — possibly infinite
sumFirst :: Int -> [Long] -> Long
sumFirst n xs = sum (take n xs)

--- lists: Frege filtering an okay source, lazily, into a Frege list
evensOf :: [Long] -> [Long]
evensOf = filter even

--- existing Frege IO that BLOCKS, lifted (interop-lift-cancellation):
--- ten seconds, unless the thread running it is interrupted
native sleepMs java.lang.Thread.sleep :: Long -> IO () throws InterruptedException

sleepyLift :: Prog String
sleepyLift = liftIO (sleepMs 10000 >> return "woke")

--- the same, observable: after its sleep the action leaves a mark the
--- test can read, so "the work stopped" is told apart from "the fiber
--- was reported finished while its thread slept on"
native setProp java.lang.System.setProperty :: String -> String -> IO (Maybe String)

markAfter :: String -> Long -> Prog String
markAfter key ms = liftIO (sleepMs ms >> setProp key "woke" >> return "woke")
