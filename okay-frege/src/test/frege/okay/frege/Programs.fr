--- Frege programs the okay tests run (TestFrege), written in okay.frege.Prog
module okay.frege.Programs where

import okay.frege.Prog

--- the core effects' operations (okay.frege.Ops), one pure native each
pure native askOp    okay.frege.Ops.ask     :: () -> Obj
pure native getOp    okay.frege.Ops.get     :: () -> Obj
pure native setOp    okay.frege.Ops.set     :: Long -> Obj
pure native raiseOp  okay.frege.Ops.raise   :: String -> Obj
pure native choose2  okay.frege.Ops.choose2 :: Long -> Long -> Obj

--- a running sum, iteratee style: await until Nothing, tell each sum
runningSum :: Long -> Prog ()
runningSum acc = do
  m <- await
  case m of
    Nothing -> return ()
    Just x  -> tell (acc + x) >> runningSum (acc + x)

--- tells a header before its first await, and a count at the end
framed :: Int -> Prog ()
framed n = do
  when (n == 0) (tell "head")
  m <- await
  case m of
    Nothing -> tell ("n=" ++ show n)
    Just x  -> tell (show (x :: Long)) >> framed (n + 1)

--- reads three elements and returns: the stage ends early
firstThree :: Int -> Prog ()
firstThree 3 = return ()
firstThree n = do
  m <- await
  case m of
    Nothing -> return ()
    Just x  -> tell (x :: Long) >> firstThree (n + 1)

--- Reader and State, performed from Frege: env * 1000 + the state after +1
readerState :: Prog Long
readerState = do
  env <- perform (askOp ())
  s   <- perform (getOp ())
  _   <- (perform (setOp (s + 1)) :: Prog Long)
  s2  <- perform (getOp ())
  return (env * 1000 + s2)

--- a Throws raised from Frege
raising :: Prog Long
raising = perform (raiseOp "boom from frege")

--- MULTI-SHOT: Choose resumes the continuation once per branch
choosing :: Prog Long
choosing = do
  a <- perform (choose2 1 2)
  b <- perform (choose2 10 20)
  return (a + b)

--- existing Frege IO, lifted as one step
greetIO :: String -> IO String
greetIO who = return ("hello, " ++ who)

usesIO :: Prog String
usesIO = do
  g <- liftIO (greetIO "okay")
  tell g
  return (g ++ "!")

--- a Frege failure of its own, inside the tree
failing :: Prog Long
failing = perform (askOp ()) >>= \e -> if (e :: Long) > 0 then error "frege says no" else return e

--- a long loop, for the stack and the price
countTo :: Long -> Long -> Prog ()
countTo i n = if i >= n then return () else tell i >> countTo (i + 1) n

--- existing Frege IO lifted in a program okay RUNS (no tell): its answer
liftedAnswer :: Prog String
liftedAnswer = fmap (++ "!") (liftIO (greetIO "okay"))
