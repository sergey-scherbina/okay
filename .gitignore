target/
.claude
.idea/
.vscode/
.DS_Store
.bsp/

# git worktrees for parallel work (multi-agent protocol)
.worktrees/
okay-chat*.db
okay-chat.log/
# the demo board and the two-node log are FileStore DIRECTORIES the
# demo creates where it is told. Their defaults now live under
# target/ (ChatDemo.ChatConf.dbDefault), so these two lines are for
# older checkouts and for anyone who points the env var back here.
# Keep in mind what caught us once: an ignore rule does not reach a
# path that is ALREADY TRACKED — 8f2c56d7 committed a segment of the
# first one straight past this line.
okay-board.log/
hs_err_pid*.log

# JMH -prof jfr writes its recording beside the project
*.jfr
compare/okay.*-AverageTime-*/
compare/jmh-result.text

# a golden facade test leaves its regeneration beside the golden (foreign-module-trait)
*.scala.new
