--- A Frege program okay runs (specs/frege.md): an answer, or ONE operation
--- for okay and the rest of the program as a Frege function of its answer.
---
--- This is okay's own freer tree, written in Frege. The okay driver
--- (okay.frege.Frege, Scala) walks it: it performs each operation under
--- whatever handlers run the okay program and calls the continuation
--- with the answer. Because the continuation is a plain Frege function,
--- a handler may call it more than once (Choice), and no thread is ever
--- parked — the effects are okay's, the program is Frege's.
---
--- Existing Frege IO code enters by 'liftIO': the driver runs the IO
--- action, which never calls back into okay, as one step.
module okay.frege.Prog where

--- a value crossing the seam, as Java sees it
data Obj = pure native java.lang.Object

--- An okay operation whose answer is an @a@. The type parameter is a
--- PHANTOM — Java sees the operation value itself — and it is what the
--- native that makes the operation declares, the way okay's own
--- @effect[F, A](op: F[A])@ reads the answer type off the operation:
---
--- > pure native askOp okay.frege.Ops.ask :: () -> Operation Long
---
--- so 'perform' answers what its operation says, not whatever its caller
--- wishes.
data Operation a = pure native java.lang.Object {}

pure native toObj    "(Object)" :: a -> Obj
pure native opObj    "(Object)" :: Operation a -> Obj
pure native isNull   java.util.Objects.isNull :: Obj -> Bool

--- nowarn: application of fromObj will diverge
--- The one place an answer from okay is read at a type: a Java cast,
--- which Frege emits as a generic @(A)(Object)x@ only for a native of
--- exactly this shape, @Obj -> a@ — the shape its check flags, since
--- nothing in the argument fixes @a@. Here the caller does: it is
--- PRIVATE, and every use reads an answer at the type the operation
--- ('perform' through 'Operation' @a@), the stage's input ('await') or
--- the lifted action ('liftIO') already fixed. Acknowledged the way
--- Frege's own Prelude acknowledges @error :: String -> u@.
private pure native fromObj "(Object)" :: Obj -> a

--- what one step asks of okay
data Op = Await            --- the next input of a stage (okay's Take)
        | Tell Obj         --- emit one output (okay's Writer)
        | Perform Obj      --- an operation of the okay program's row
        | Lift (IO Obj)    --- existing Frege IO, run by the driver as one step

--- a program: its answer, or an operation and what follows from its
--- answer (the driver hands the answer over as a Java object)
data Prog a = Done a | Step Op (Obj -> Prog a)

bindP :: Prog a -> (a -> Prog b) -> Prog b
bindP (Done a)    f = f a
bindP (Step op k) f = Step op (\x -> bindP (k x) f)

instance Functor Prog where
  fmap f p = bindP p (\a -> Done (f a))

instance Applicative Prog where
  pure = Done
  pf <*> px = bindP pf (\f -> fmap f px)

instance Monad Prog where
  (>>=) = bindP

--- the next element of a stage's input, Nothing at its end (the
--- element's type is the stage's input type, fixed where it is run)
await :: Prog (Maybe a)
await = Step Await (\x -> Done (if isNull x then Nothing else Just (fromObj x)))

--- emit one element of a stage's output
tell :: b -> Prog ()
tell b = Step (Tell (toObj b)) (\_ -> Done ())

--- perform an okay operation; its answer is the type the operation names
perform :: Operation a -> Prog a
perform op = Step (Perform (opObj op)) (\x -> Done (fromObj x))

--- existing Frege IO, as one step of the program
liftIO :: IO a -> Prog a
liftIO io = Step (Lift (fmap toObj io)) (\x -> Done (fromObj x))
